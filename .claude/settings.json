{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-dangerous-bash.py\"",
            "args": []
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/audit-bash.py\"",
            "args": []
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python scripts/pdf-search.py *)",
      "Bash(bash scripts/webfetch-escalate.sh *)",
      "Bash(bash scripts/headless-check.sh *)",
      "Bash(python scripts/roster-mark-added.py *)",
      "Bash(npm test *)",
      "Bash(npm run build)",
      "Bash(sleep *)",
      "Bash(where *)",
      "Bash(python3 scripts/pdf-search.py *)",
      "Bash(python3 scripts/roster-mark-added.py *)",
      "Bash"
    ]
  }
}